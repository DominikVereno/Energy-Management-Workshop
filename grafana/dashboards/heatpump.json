      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-openems"
          },
          "query": "from(bucket: \"openems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"data\")\n  |> filter(fn: (r) => r._field == \"heatpump0/FlowTemperature\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"Vorlauftemperatur (Ist)\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-openems"
          },
          "query": "from(bucket: \"openems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"data\")\n  |> filter(fn: (r) => r._field == \"heatpump0/FlowTemperatureSetpoint\" or r._field == \"heatpump0/OperationMode\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r[\"heatpump0/OperationMode\"] == 4.0)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      \"Soll-Vorlauf (Betriebsart Manuell Heizen)\": r[\"heatpump0/FlowTemperatureSetpoint\"]\n  }))",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-openems"
          },
          "hide": false,
          "query": "from(bucket: \"openems\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"data\")\r\n  |> filter(fn: (r) => r._field == \"heatpump0/HeatingCurveFlowTemperatureSetpoint\" or r._field == \"heatpump0/OperationMode\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> filter(fn: (r) => r[\"heatpump0/OperationMode\"] == 2.0)\r\n  |> map(fn: (r) => ({\r\n      _time: r._time,\r\n      \"Soll-Vorlauf (Betriebsart Heizkurve)\": r[\"heatpump0/HeatingCurveFlowTemperatureSetpoint\"]\r\n  }))",
          "refId": "C"
        }
      ],
      "title": "Vorlauf-Regelung (Ist vs. Soll)",
      "type": "timeseries"
